{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verygoodplugins.com/schemas/automem-evals/memdelta-controlled-results.v1.json",
  "title": "AutoMem controlled-evaluation metadata",
  "description": "Required metadata block for a result that makes a MemDelta-style attribution claim.",
  "$ref": "#/$defs/controlled_evaluation",
  "$defs": {
    "nullable_number": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "controlled_evaluation": {
      "type": "object",
      "required": [
        "embedding_model",
        "reader_model",
        "judge",
        "graph",
        "recall",
        "write_path_cost"
      ],
      "properties": {
        "schema": {"const": "automem-evals.memdelta-controlled-results.v1"},
        "embedding_model": {
          "type": "object",
          "required": ["name", "mode"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "mode": {"enum": ["fixed", "automem-default"]},
            "dimensions": {"type": ["integer", "null"], "minimum": 1},
            "revision": {"type": ["string", "null"]}
          }
        },
        "reader_model": {
          "type": "object",
          "required": ["name", "family"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "family": {"type": "string", "minLength": 1},
            "provider": {"type": ["string", "null"]},
            "snapshot": {"type": ["string", "null"]}
          }
        },
        "judge": {
          "type": "object",
          "required": ["model", "profile", "provider", "snapshot_pinned"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "profile": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "snapshot_pinned": {"type": "boolean"}
          }
        },
        "graph": {
          "type": "object",
          "required": ["edges"],
          "properties": {
            "edges": {"enum": ["on", "off"]},
            "edge_types": {"type": "array", "items": {"type": "string"}}
          }
        },
        "recall": {
          "type": "object",
          "required": [
            "relation_expansion",
            "relation_limit",
            "expansion_limit",
            "expansion_only_memory_count"
          ],
          "properties": {
            "relation_expansion": {"enum": ["on", "off"]},
            "relation_limit": {"$ref": "#/$defs/nullable_number"},
            "expansion_limit": {"$ref": "#/$defs/nullable_number"},
            "expansion_only_memory_count": {"$ref": "#/$defs/nullable_number"}
          }
        },
        "write_path_cost": {
          "type": "object",
          "required": [
            "input_tokens",
            "source_content_tokens",
            "output_tokens",
            "latency_ms",
            "enrichment_calls",
            "memory_write_calls",
            "association_write_calls",
            "association_write_failures",
            "unavailable_measurements"
          ],
          "properties": {
            "input_tokens": {"$ref": "#/$defs/nullable_number"},
            "source_content_tokens": {"$ref": "#/$defs/nullable_number"},
            "output_tokens": {"$ref": "#/$defs/nullable_number"},
            "latency_ms": {"$ref": "#/$defs/nullable_number"},
            "enrichment_calls": {"$ref": "#/$defs/nullable_number"},
            "memory_write_calls": {"$ref": "#/$defs/nullable_number"},
            "association_write_calls": {"$ref": "#/$defs/nullable_number"},
            "association_write_failures": {"$ref": "#/$defs/nullable_number"},
            "unavailable_measurements": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
