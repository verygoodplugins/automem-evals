{
  "name": "bare_tag_1m_v3_expand",
  "description": "Bare-tag 1M scheme with expand_relations turned on. Tests whether graph traversal surfaces additional relevant memories beyond direct semantic + tag matches.",
  "phase_1_preferences": {
    "tags": ["preference"],
    "limit": 20
  },
  "phase_2_task_context": {
    "queries_suffix": ["user corrections", "recent decisions"],
    "tags_from": "project_slug",
    "auto_decompose": true,
    "time_query": "last 90 days",
    "limit": 30,
    "expand_relations": true,
    "expand_min_strength": 0.5,
    "relation_limit": 8,
    "expansion_limit": 60
  },
  "phase_3_debugging": {
    "tags": ["bugfix", "solution"],
    "limit": 20,
    "expand_relations": true,
    "expand_min_strength": 0.5,
    "relation_limit": 8,
    "expansion_limit": 40
  }
}
