# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
.venv-beam/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Data — generated / large files
#
# Policy: commit run metadata (MANIFEST.json), audit trails (shim.log,
# shim_stats.jsonl), and curated reports (SUMMARY-*.md, docs/session_*.md).
# Ignore raw model output and per-question trees — they're reproducible from
# the seeded corpus + the committed ruleset + the pinned judge snapshot.
data/transcripts/*.json
data/transcripts/*.jsonl
data/results/*.json
data/results/*-comparison.md
data/results/matrix/*.json
# BEAM artifacts — recursive patterns so deeper run layouts don't leak through.
data/results/beam/**/beam_results_*.json
data/results/beam/**/beam-output/

# Sweep runs — raw per-run artifacts (qdrant dumps, health snapshots, probe diffs,
# token files). Reproducible from the seeded corpus + the committed runner.
# If a curated audit file emerges (e.g. SUMMARY.md per run), add a `!` exception.
data/sweep_runs/

# Matrix stack compose overrides are generated local runtime files. Commit the
# helper and curated markdown reports, not host-port-specific overrides.
data/matrix_stacks/*.override.yml

# Seed memories — ignore generated corpora by default, but ship the small v1
# snapshot so `scripts/seed_from_snapshot.py` works zero-cost after a fresh clone.
# v2 is 5MB and cheaply regeneratable; keep it ignored.
data/seed_memories/*.jsonl
data/seed_memories/*.embedded.jsonl
data/seed_memories/*.manifest.json
!data/seed_memories/corpus_v1.jsonl
!data/seed_memories/corpus_v1.embedded.jsonl
!data/seed_memories/corpus_v1.manifest.json

# Keep placeholder dirs
!data/transcripts/.gitkeep
!data/results/.gitkeep
!data/seed_memories/.gitkeep

# Secrets / environment
.env
.env.*
!.env.example
*.key
*.pem

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code / agent-local state
.claude/

# Logs / output artifacts
*.log
output/
tmp/
# BEAM per-run shim.log is the audit trail — keep these even though *.log is ignored
!data/results/beam/*/shim.log

# writ — adapter + entry point are copied into the submodule at run time
third_party/writ/run_automem.ts
third_party/writ/src/adapters/automem.ts
# writ run outputs (regenerable; commit only curated SUMMARY-*.md if needed)
data/results/writ/*/
